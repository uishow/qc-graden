<view class="page-root {{theme}}">
  <view class="field-label">材料名称 *</view>
  <input class="input" placeholder="如：柔光砖 750x1500" value="{{name}}" data-field="name" bindinput="onInput" />

  <view class="row" style="gap:20rpx">
    <view style="flex:1">
      <view class="field-label">分类</view>
      <picker range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="input">{{categories[categoryIndex]}}</view>
      </picker>
    </view>
    <view style="flex:1">
      <view class="field-label">状态</view>
      <picker range="{{statusNames}}" value="{{statusIndex}}" bindchange="onStatusChange">
        <view class="input">{{statusNames[statusIndex]}}</view>
      </picker>
    </view>
  </view>

  <view class="field-label">归属</view>
  <picker range="{{belongNames}}" value="{{belongIndex}}" bindchange="onBelongChange">
    <view class="input">{{belongNames[belongIndex]}}</view>
  </picker>
  <block wx:if="{{belongIndex === 1}}">
    <view class="field-label">全屋定制子类</view>
    <picker range="{{subNames}}" value="{{subIndex}}" bindchange="onSubChange">
      <view class="input">{{subNames[subIndex]}}</view>
    </picker>
  </block>

  <view class="field-label">所属阶段（可多选）</view>
  <view class="input picker" bindtap="openStagePicker">
    <block wx:if="{{stageIdsSelected.length === 0}}"><text class="picker-empty">选择阶段（可多选，不选归入通用）</text></block>
    <block wx:else><text class="picker-text" style="color:var(--c-primary)">{{stageIdsSelected.length}} 个阶段 · {{stageText}}</text></block>
  </view>

  <view class="row" style="gap:20rpx">
    <view style="flex:1">
      <view class="field-label">品牌</view>
      <input class="input" placeholder="如：马可波罗" value="{{brand}}" data-field="brand" bindinput="onInput" />
    </view>
    <view style="flex:1">
      <view class="field-label">规格</view>
      <input class="input" placeholder="如：750x1500mm" value="{{spec}}" data-field="spec" bindinput="onInput" />
    </view>
  </view>

  <view class="row" style="gap:20rpx">
    <view style="flex:1">
      <view class="field-label">数量</view>
      <input class="input" type="digit" value="{{quantity}}" data-field="quantity" bindinput="onInput" />
    </view>
    <view style="flex:1">
      <view class="field-label">单位</view>
      <input class="input" placeholder="片 / ㎡ / 个" value="{{unit}}" data-field="unit" bindinput="onInput" />
    </view>
  </view>

  <view class="field-label">单价（元）</view>
  <input class="input" type="digit" placeholder="0.00" value="{{unitPrice}}" data-field="unitPrice" bindinput="onInput" />

  <view class="field-label">备注</view>
  <input class="input" placeholder="如：客厅通铺，含损耗" value="{{remark}}" data-field="remark" bindinput="onInput" />

  <view class="field-label">附件凭证（报价单 / 收据 / 截图 / 文件，最多 9 个）</view>
  <view class="att-grid">
    <view wx:for="{{attachments}}" wx:key="fileID" class="att-item">
      <image wx:if="{{item.kind === 'image'}}" class="att-thumb" src="{{item.fileID}}" mode="aspectFill"
        data-index="{{index}}" bindtap="previewAttachment" />
      <view wx:else class="att-file" data-index="{{index}}" bindtap="previewAttachment">
        <view class="att-file-name">{{item.name}}</view>
      </view>
      <view class="att-del" data-index="{{index}}" catchtap="removeAttachment">×</view>
    </view>
    <view wx:if="{{attachments.length < 9}}" class="att-add" bindtap="addAttachment">＋ 添加</view>
  </view>

  <view wx:if="{{revisions.length}}" class="card" style="margin-top:24rpx">
    <view class="muted" style="margin-bottom:8rpx">修改历史</view>
    <view wx:for="{{revisions}}" wx:key="index" class="between" style="padding:6rpx 0;font-size:24rpx">
      <view class="muted">{{item.timeText}}</view>
      <view>{{item.actionText}}<block wx:if="{{item.newVersion}}"> · v{{item.newVersion}}</block></view>
    </view>
  </view>

  <view class="btn-primary" style="margin-top:32rpx" bindtap="onSave">{{saving ? '保存中…' : '保存'}}</view>

  <!-- 阶段多选弹窗：嵌入 page-root 内部，避免顶级兄弟节点 fixed 在部分机型失效 -->
  <view wx:if="{{showStagePicker}}" class="mask" bindtap="cancelStagePicker">
    <view class="sheet" catchtap="noop">
      <view class="between sheet-head">
        <view style="font-weight:600;font-size:32rpx">选择所属阶段（可多选）</view>
        <view class="muted" bindtap="cancelStagePicker">✕</view>
      </view>
      <view class="sheet-body">
        <view wx:if="{{stages.length === 0}}" class="empty">暂无可选阶段</view>
        <view
          wx:for="{{stages}}"
          wx:key="id"
          class="multi-row {{index === stages.length - 1 ? 'multi-row-last' : ''}} {{stageChecked[index] ? 'multi-row-checked' : ''}}"
          bindtap="toggleStage"
          data-index="{{index}}"
        >
          <view class="multi-name">{{item.name}}</view>
          <view class="multi-check"></view>
        </view>
      </view>
      <view class="sheet-foot">
        <view class="row" style="gap:16rpx">
          <view class="btn-outline flex1" bindtap="cancelStagePicker">取消</view>
          <view class="btn-primary flex1" bindtap="confirmStagePicker">确定</view>
        </view>
      </view>
    </view>
  </view>
</view>
