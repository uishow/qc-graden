/* 通用令牌由 app.wxss 提供 */

.field-title { font-weight: 600; font-size: 30rpx; margin-bottom: 20rpx; }

/* 三维评分：每行左侧「维度名+提示」右侧 5 星 */
.rate-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-top: 1rpx solid var(--c-card-border); }
.rate-row-first { /* 顶部用 card 的内边距替代，不用再加 border-top */ }
.rate-row-last { border-bottom: none; }
.rate-label { min-width: 0; flex: 1; }
.rate-name { font-size: 30rpx; font-weight: 600; color: var(--c-text); }
.rate-hint { font-size: 22rpx; margin-top: 4rpx; }
.rate-stars { display: flex; gap: 8rpx; flex-shrink: 0; margin-left: 16rpx; }
.star {
  font-size: 44rpx; line-height: 1; color: var(--c-card-border);
  padding: 6rpx 4rpx; cursor: pointer;
  transition: color .15s ease;
}
.star-on { color: var(--c-accent); }

/* 意见框：更高的最小高度 + 自增高度 */
.feedback-textarea { min-height: 320rpx; }
.feedback-count { text-align: right; font-size: 22rpx; margin-top: -8rpx; }

/* 提交流程按钮 */
.submit-btn { margin-top: 16rpx; }

.done-card { padding: 40rpx 24rpx 32rpx; }

/* 提交回执：把用户刚提交的内容再展示一遍（用户点完「提交」看不到自己填了什么，这里就是确认） */
.receipt { margin-top: 28rpx; text-align: left; }
.receipt-row {
  border-top: 1rpx solid var(--c-card-border);
  padding: 22rpx 0;
}
.receipt-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--c-text);
  margin-bottom: 16rpx;
}
.receipt-grid { display: flex; flex-direction: column; gap: 12rpx; }
.receipt-dim {
  display: flex; align-items: center; justify-content: space-between;
}
.receipt-dim-name { font-size: 24rpx; flex: 0 0 auto; min-width: 100rpx; }
.receipt-stars { display: flex; gap: 4rpx; }
.r-star { font-size: 28rpx; color: #8B7B5A; opacity: 0.45; line-height: 1; padding: 0 2rpx; }
.r-star-on { color: var(--c-accent); opacity: 1; }
.receipt-comment {
  background: var(--c-secondary-bg);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
  color: var(--c-text);
}
.receipt-time {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--c-text-2);
  text-align: right;
}

/* ============================================================
 * 我的反馈历史（合并自独立 /list 页，commit 6 2026-10-15）
 *   - 历史区与表单/回执并行展示，让用户一个页面搞定「写+看」
 *   - 折叠默认展开（解决「自己提交看不到」的问题——以前需跳独立页才能看）
 * ============================================================ */
.history-card { margin-top: 20rpx; }
.history-head { padding: 4rpx 0; }

/* 管理员「我的反馈 / 全员反馈」切 tab（沿用 pages/feedback/list 同样的 tabs 样式） */
.tabs { display: flex; gap: 12rpx; margin: 20rpx 0 16rpx; }
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--c-text-2);
  background: var(--c-card);
  border: 1rpx solid var(--c-card-border);
  border-radius: 12rpx;
}
.tab.tab-on {
  color: var(--c-primary);
  border-color: var(--c-primary);
  background: var(--c-secondary-bg);
}

.history-item {
  border-top: 1rpx solid var(--c-card-border);
  padding: 20rpx 0;
}
.history-item:first-of-type { border-top: none; }
.history-row {
  display: flex;
  gap: 20rpx;
  margin: 16rpx 0;
  flex-wrap: wrap;
}
.history-dim { display: flex; align-items: center; gap: 6rpx; }
.history-stars { display: flex; gap: 2rpx; }
.h-star { font-size: 24rpx; color: #8B7B5A; opacity: 0.45; line-height: 1; }
.h-star-on { color: var(--c-accent); opacity: 1; }

.history-comment {
  background: var(--c-secondary-bg);
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
  margin: 8rpx 0;
}
.history-meta { font-size: 22rpx; margin-top: 10rpx; }

/* 历史条目整体可点击：视觉提示（弱化反馈，避免和真按钮混淆） */
.history-item.history-tap {
  cursor: pointer;
  transition: background-color .15s ease;
  margin: 0 -16rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
  border-radius: 12rpx;
}
.history-item.history-tap:active {
  background-color: var(--c-secondary-bg);
}

/* ============================================================
 * 反馈详情弹窗
 * ============================================================ */
.detail-section {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--c-card-border);
}
.detail-section:last-child { border-bottom: none; }
.detail-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--c-text);
  margin-bottom: 16rpx;
}
.detail-dim-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 0;
}
.detail-dim-name {
  font-size: 26rpx;
  color: var(--c-text-2);
  width: 110rpx;
  flex-shrink: 0;
}
.detail-dim-stars { display: flex; gap: 2rpx; flex: 1; min-width: 0; }
.detail-dim-num {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--c-accent);
  flex-shrink: 0;
}
.detail-comment {
  background: var(--c-secondary-bg);
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
  color: var(--c-text);
}
.detail-meta-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 8rpx 0;
  font-size: 26rpx;
}
.detail-meta-row .muted { min-width: 110rpx; flex-shrink: 0; }
