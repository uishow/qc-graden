/* 反馈历史列表样式 */
/* tabs（管理员「我的反馈/全员反馈」切 tab） */
/* .tabs/.tab/.tab-on 等类由首页 knowledge/import 沿用，未必定义；用本地简化版 */
.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--c-text-2);
  background: var(--c-card);
  border: 1rpx solid var(--c-card-border);
  border-radius: 12rpx;
}
.tab.tab-on {
  color: var(--c-primary);
  border-color: var(--c-primary);
  background: var(--c-secondary-bg);
}

/* 列表项 */
.fb-item { padding: 24rpx 28rpx; }
.fb-row {
  display: flex;
  gap: 20rpx;
  margin: 18rpx 0;
  flex-wrap: wrap;
}
.fb-dim {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.fb-stars { display: flex; gap: 2rpx; }
.fb-star { font-size: 24rpx; color: var(--c-card-border); line-height: 1; }
.fb-star-on { color: var(--c-accent); }

.fb-comment {
  background: var(--c-secondary-bg);
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
  margin: 8rpx 0;
}
.fb-meta {
  font-size: 22rpx;
  margin-top: 10rpx;
}
