<view class="page-root {{theme}}">

  <view class="title-serif" style="margin-bottom:8rpx">APP 评价与意见</view>
  <view class="muted" style="margin-bottom:24rpx">您的反馈会推动我们改进，先打个分，再写下想说的话；下方可查看历史记录。</view>

  <!-- 三维评分（易用性 / 美观性 / 功能性），每行 5 颗可点星 -->
  <view class="card" wx:if="{{!done}}">
    <view class="field-title">综合评分</view>

    <view class="rate-row">
      <view class="rate-label">
        <view class="rate-name">易用性</view>
        <view class="muted rate-hint">上手与日常使用顺畅度</view>
      </view>
      <view class="rate-stars">
        <view
          wx:for="{{5}}"
          wx:key="u{{index}}"
          class="star {{scores.usability > index ? 'star-on' : ''}}"
          bindtap="setScore"
          data-field="usability"
          data-value="{{index + 1}}"
        >★</view>
      </view>
    </view>

    <view class="rate-row">
      <view class="rate-label">
        <view class="rate-name">美观性</view>
        <view class="muted rate-hint">界面与排版观感</view>
      </view>
      <view class="rate-stars">
        <view
          wx:for="{{5}}"
          wx:key="a{{index}}"
          class="star {{scores.aesthetics > index ? 'star-on' : ''}}"
          bindtap="setScore"
          data-field="aesthetics"
          data-value="{{index + 1}}"
        >★</view>
      </view>
    </view>

    <view class="rate-row rate-row-last">
      <view class="rate-label">
        <view class="rate-name">功能性</view>
        <view class="muted rate-hint">功能完整与可用程度</view>
      </view>
      <view class="rate-stars">
        <view
          wx:for="{{5}}"
          wx:key="f{{index}}"
          class="star {{scores.functionality > index ? 'star-on' : ''}}"
          bindtap="setScore"
          data-field="functionality"
          data-value="{{index + 1}}"
        >★</view>
      </view>
    </view>
  </view>

  <!-- 意见与建议（maxlength=-1 防 140 截断；auto-height 跟随内容自增） -->
  <view class="card" wx:if="{{!done}}">
    <view class="field-title">意见与建议</view>
    <textarea
      class="textarea feedback-textarea"
      placeholder="想吐槽、想新功能、想改进的地方…（选填，限 1000 字）"
      placeholder-class="muted"
      maxlength="{{-1}}"
      auto-height
      value="{{comment}}"
      bindinput="onCommentInput"
    ></textarea>
    <view class="muted feedback-count">{{comment.length}}/1000</view>
  </view>

  <!-- 提交按钮（提交后整段表单隐藏，只留回执卡片） -->
  <view wx:if="{{!done}}" class="btn-primary submit-btn" bindtap="submit">{{submitting ? '提交中…' : '提交评价'}}</view>

  <!-- 提交成功：感谢 + 回执（这里复现你刚提交的内容，方便确认「提交的就是这个」；原来只显示感谢文案，用户看不到自己写的话） -->
  <view wx:if="{{done && doneSnapshot}}" class="card done-card">
    <view style="text-align:center">
      <view style="font-size:60rpx;line-height:1">✅</view>
      <view style="font-weight:600;font-size:32rpx;margin-top:12rpx">感谢您的反馈</view>
      <view class="muted" style="margin-top:8rpx">已收到，以下是你刚提交的内容</view>
    </view>

    <view class="receipt">
      <!-- 综合评分回执 -->
      <view wx:if="{{doneSnapshot.hasScores}}" class="receipt-row">
        <view class="receipt-title">综合评分</view>
        <view class="receipt-grid">
          <view class="receipt-dim">
            <text class="muted receipt-dim-name">易用性</text>
            <text class="receipt-stars">
              <text wx:for="{{5}}" wx:key="ru{{index}}" class="r-star {{doneSnapshot.scores.usability > index ? 'r-star-on' : ''}}">★</text>
            </text>
          </view>
          <view class="receipt-dim">
            <text class="muted receipt-dim-name">美观性</text>
            <text class="receipt-stars">
              <text wx:for="{{5}}" wx:key="ra{{index}}" class="r-star {{doneSnapshot.scores.aesthetics > index ? 'r-star-on' : ''}}">★</text>
            </text>
          </view>
          <view class="receipt-dim">
            <text class="muted receipt-dim-name">功能性</text>
            <text class="receipt-stars">
              <text wx:for="{{5}}" wx:key="rf{{index}}" class="r-star {{doneSnapshot.scores.functionality > index ? 'r-star-on' : ''}}">★</text>
            </text>
          </view>
        </view>
      </view>

      <!-- 意见回执 -->
      <view wx:if="{{doneSnapshot.hasComment}}" class="receipt-row">
        <view class="receipt-title">意见与建议</view>
        <view class="receipt-comment">{{doneSnapshot.comment}}</view>
      </view>

      <view wx:if="{{doneSnapshot.submittedAt}}" class="receipt-time">
        提交于 {{doneSnapshot.submittedAt}}
      </view>
    </view>

    <view class="row" style="gap:16rpx;margin-top:28rpx">
      <view class="btn-outline flex1" bindtap="resetAgain">再写一条</view>
      <view class="btn-primary flex1" bindtap="goBack">返回「我的」</view>
    </view>
  </view>

  <!-- 我的反馈历史：原本是独立 /list 页（commit 6），现合并到本页下方折叠区
       - 普通用户：只看自己提交的（自动按 openid 过滤）
       - 管理员：可在「我的反馈 / 全员反馈」两 tab 切换
       - 默认展开；提交新评价后会自动刷新 -->
  <view class="card history-card">
    <view class="between history-head" bindtap="toggleHistory">
      <view>
        <text style="font-weight:600;font-size:30rpx">我的反馈历史</text>
        <text wx:if="{{isManager}}" class="muted" style="margin-left:12rpx;font-weight:400;font-size:22rpx">（管理员视图）</text>
      </view>
      <view class="muted">{{showHistory ? '收起 ▴' : '展开 ▾'}}</view>
    </view>

    <block wx:if="{{showHistory}}">
      <!-- 管理员 tabs -->
      <view wx:if="{{isManager}}" class="tabs">
        <view class="tab {{historyScope === 'self' ? 'tab-on' : ''}}" data-scope="self" bindtap="switchHistoryScope">我的反馈</view>
        <view class="tab {{historyScope === 'all' ? 'tab-on' : ''}}" data-scope="all" bindtap="switchHistoryScope">全员反馈</view>
      </view>

      <view wx:if="{{historyLoading}}" class="muted" style="margin-top:16rpx">加载中…</view>
      <view wx:elif="{{historyList.length === 0}}" class="muted" style="margin-top:16rpx">{{historyEmptyText || '还没有反馈记录'}}</view>

      <block wx:else>
        <view wx:for="{{historyList}}" wx:key="id" class="history-item history-tap" data-index="{{index}}" bindtap="openDetail">
          <view class="between">
            <view class="muted">{{item.timeText}}</view>
            <view style="display:flex;gap:8rpx;align-items:center">
              <view wx:if="{{item.fromLocal}}" class="tag" style="font-size:20rpx;padding:2rpx 10rpx;background:var(--c-secondary-bg);color:var(--c-text-2)">本地缓存</view>
              <view wx:if="{{historyScope === 'all'}}" class="muted" style="font-size:22rpx">用户 ···{{item.openidTail}}</view>
            </view>
          </view>
          <view class="history-row">
            <view class="history-dim">
              <text class="muted" style="font-size:22rpx">易用性</text>
              <text class="history-stars">
                <text wx:for="{{5}}" wx:key="u{{index}}" class="h-star {{item.scores.usability > index ? 'h-star-on' : ''}}">★</text>
              </text>
            </view>
            <view class="history-dim">
              <text class="muted" style="font-size:22rpx">美观性</text>
              <text class="history-stars">
                <text wx:for="{{5}}" wx:key="a{{index}}" class="h-star {{item.scores.aesthetics > index ? 'h-star-on' : ''}}">★</text>
              </text>
            </view>
            <view class="history-dim">
              <text class="muted" style="font-size:22rpx">功能性</text>
              <text class="history-stars">
                <text wx:for="{{5}}" wx:key="f{{index}}" class="h-star {{item.scores.functionality > index ? 'h-star-on' : ''}}">★</text>
              </text>
            </view>
          </view>
          <view wx:if="{{item.comment}}" class="history-comment">{{item.comment}}</view>
          <view wx:if="{{item.system || item.app_version}}" class="muted history-meta">
            <block wx:if="{{item.system}}">{{item.system}}</block>
            <block wx:if="{{item.app_version}}"> · v{{item.app_version}}</block>
          </view>
        </view>
      </block>
    </block>
  </view>

  <!-- 反馈详情弹窗：点击历史条目后从底部弹出，把每条反馈的完整信息呈现出来
       （之前只列了缩略评分 + 系统+意见，看不到具体分数数字、平台、版本号、来源） -->
  <view wx:if="{{showDetail && detailItem}}" class="mask" bindtap="closeDetail">
    <view class="sheet" catchtap="" style="max-height:78vh">
      <view class="sheet-head">
        <view class="between">
          <view style="font-weight:600;font-size:32rpx">反馈详情</view>
          <view class="muted" bindtap="closeDetail">关闭 ✕</view>
        </view>
        <view class="muted" style="margin-top:8rpx">{{detailItem.timeText}} 提交</view>
      </view>
      <view class="sheet-body">
        <!-- 三维评分（数字 + 星） -->
        <view class="detail-section">
          <view class="detail-section-title">综合评分</view>
          <view class="detail-dim-row">
            <view class="detail-dim-name">易用性</view>
            <view class="detail-dim-stars">
              <text wx:for="{{5}}" wx:key="du{{index}}" class="h-star {{detailItem.scores.usability > index ? 'h-star-on' : ''}}">★</text>
            </view>
            <view class="detail-dim-num">{{detailItem.scores.usability || 0}} 分</view>
          </view>
          <view class="detail-dim-row">
            <view class="detail-dim-name">美观性</view>
            <view class="detail-dim-stars">
              <text wx:for="{{5}}" wx:key="da{{index}}" class="h-star {{detailItem.scores.aesthetics > index ? 'h-star-on' : ''}}">★</text>
            </view>
            <view class="detail-dim-num">{{detailItem.scores.aesthetics || 0}} 分</view>
          </view>
          <view class="detail-dim-row">
            <view class="detail-dim-name">功能性</view>
            <view class="detail-dim-stars">
              <text wx:for="{{5}}" wx:key="df{{index}}" class="h-star {{detailItem.scores.functionality > index ? 'h-star-on' : ''}}">★</text>
            </view>
            <view class="detail-dim-num">{{detailItem.scores.functionality || 0}} 分</view>
          </view>
        </view>

        <!-- 意见（仅在填写时展示） -->
        <view wx:if="{{detailItem.comment}}" class="detail-section">
          <view class="detail-section-title">意见与建议</view>
          <view class="detail-comment">{{detailItem.comment}}</view>
        </view>
        <view wx:else class="detail-section">
          <view class="detail-section-title">意见与建议</view>
          <view class="muted">未填写</view>
        </view>

        <!-- 环境信息 -->
        <view class="detail-section">
          <view class="detail-section-title">环境信息</view>
          <view wx:if="{{historyScope === 'all' && detailItem.openidTail}}" class="detail-meta-row">
            <text class="muted">用户</text><text>···{{detailItem.openidTail}}</text>
          </view>
          <view wx:if="{{detailItem.system}}" class="detail-meta-row">
            <text class="muted">系统</text><text>{{detailItem.system}}</text>
          </view>
          <view wx:if="{{detailItem.app_version}}" class="detail-meta-row">
            <text class="muted">版本</text><text>v{{detailItem.app_version}}</text>
          </view>
          <view wx:if="{{detailItem.platform}}" class="detail-meta-row">
            <text class="muted">平台</text><text>{{detailItem.platform}}</text>
          </view>
          <view wx:if="{{!detailItem.system && !detailItem.app_version && !detailItem.platform && historyScope !== 'all'}}" class="muted">未记录</view>
        </view>

        <!-- 来源标记：本地缓存 vs 云端真数据 -->
        <view class="detail-section">
          <view class="detail-meta-row">
            <text class="muted">来源</text>
            <text wx:if="{{detailItem.fromLocal}}" style="color:var(--c-text-2)">本地缓存（云端暂无此条，多为刚提交；不会上传）</text>
            <text wx:else style="color:var(--c-secondary)">云端</text>
          </view>
          <view wx:if="{{detailItem.id}}" class="detail-meta-row">
            <text class="muted">记录 ID</text>
            <text style="font-family:monospace;font-size:22rpx;word-break:break-all">{{detailItem.id}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

</view>
