/* 主题令牌来自 app.wxss */

/* Tab 切换：知识库 / 待确认导入 */
.tabs {
  display: flex;
  background: var(--c-secondary-bg);
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--c-text-2);
  padding: 16rpx 0;
  border-radius: 999rpx;
  transition: all 0.15s;
}
.tab-on {
  background: var(--c-card);
  color: var(--c-primary);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 待确认导入区：ima 同步进来、等待人工放行的条目 */
.sync-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--c-secondary-bg);
  border: 1rpx solid var(--c-card-border);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}
.sync-hint {
  font-size: 22rpx;
  flex: 1;
  margin-right: 16rpx;
}
.pending-block {
  background: var(--c-secondary-bg);
  border: 1rpx solid var(--c-card-border);
  border-radius: 20rpx;
  padding: 20rpx 20rpx 8rpx;
  margin-bottom: 24rpx;
}
.pending-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--c-secondary);
}
.pending-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.pending-card {
  display: flex;
  background: var(--c-card);
  border: 1rpx solid var(--c-card-border);
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}
.pending-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: var(--c-secondary-bg);
}
.pending-thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--c-text-2);
  font-size: 26rpx;
}
.pending-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.pending-name {
  font-weight: 600;
  font-size: 28rpx;
  color: var(--c-text);
}
.pending-summary {
  margin-top: 4rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.pending-link {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--c-accent);
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.pending-tags {
  margin-top: 10rpx;
}
.pending-error {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #C0392B;
}
.pending-status {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--c-secondary);
}
.pending-actions {
  margin-top: 12rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}
.btn {
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  text-align: center;
}
.btn-confirm {
  background: var(--c-primary);
  color: #FFFFFF;
}
.btn-reject {
  background: transparent;
  color: var(--c-text-2);
  border: 1rpx solid var(--c-card-border);
}
.btn-sm {
  padding: 8rpx 22rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}
