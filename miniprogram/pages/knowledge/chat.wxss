/* AI 问答页：消息流 + 底部输入条（页面级 flex 布局） */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}
.chat-body {
  flex: 1;
  min-height: 0;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

/* 空状态：机器人头像 + 欢迎语 + 建议问题 */
.chat-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 20vh;
  text-align: center;
}
.empty-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--c-secondary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}
.empty-title {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--c-text);
}
.empty-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
}
.sug-wrap {
  margin-top: 32rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  padding: 0 40rpx;
}
.sug-chip {
  background: var(--c-card);
  border: 1rpx solid var(--c-card-border);
  color: var(--c-primary);
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
}
.sug-chip:active {
  opacity: 0.8;
}

/* 消息行：AI 带头像，用户靠右 */
.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}
.msg-row.me {
  justify-content: flex-end;
}
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--c-secondary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  margin-right: 14rpx;
}
.msg-col {
  max-width: 82%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.msg-row.me .msg-col {
  align-items: flex-end;
}
.bubble {
  max-width: 100%;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}
.bubble-ai {
  background: var(--c-card);
  color: var(--c-text);
  border: 1rpx solid var(--c-card-border);
  border-radius: 4rpx 18rpx 18rpx 18rpx;
}
.bubble-me {
  background: var(--c-primary);
  color: #ffffff;
  border-radius: 18rpx 18rpx 4rpx 18rpx;
}

/* 来源：强调色软底小胶囊 */
.src-row {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.src-chip {
  font-size: 22rpx;
  color: var(--c-accent);
  background: var(--c-accent-bg);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: inline-block;
}

/* 等待动画：三个呼吸点 */
.typing {
  white-space: normal;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}
.dot {
  font-size: 24rpx;
  margin: 0 5rpx;
  color: var(--c-text-2);
  animation: dot-blink 1.2s infinite;
}
.d2 { animation-delay: 0.2s; }
.d3 { animation-delay: 0.4s; }
@keyframes dot-blink {
  0%, 80%, 100% { opacity: 0.2; }
  40% { opacity: 1; }
}

/* 输入条：键盘弹出时由 js 抬升（margin-bottom = kbHeight） */
.chat-input {
  flex-shrink: 0;
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--c-bg);
  border-top: 1rpx solid var(--c-secondary-bg);
}
.chat-input-field {
  flex: 1;
  min-width: 0;
  background: var(--c-secondary-bg);
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  color: var(--c-text);
}
.send-btn {
  flex-shrink: 0;
  background: var(--c-primary);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 14rpx 34rpx;
}
.send-btn:active {
  opacity: 0.85;
}
.send-disabled {
  opacity: 0.4;
}
