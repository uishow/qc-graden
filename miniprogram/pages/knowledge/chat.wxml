<view class="page-root {{theme}} chat-page">
  <scroll-view class="chat-body" scroll-y scroll-into-view="{{lastId}}" scroll-with-animation>
    <!-- 空状态：欢迎 + 一点就能问的建议问题 -->
    <view wx:if="{{messages.length === 0}}" class="chat-empty">
      <view class="empty-avatar">🤖</view>
      <view class="empty-title">装修 AI 问答</view>
      <view class="empty-sub muted">读过知识库里的攻略，试试问我：</view>
      <view class="sug-wrap">
        <view class="sug-chip" data-q="防水怎么做？什么时候做？" bindtap="sendSuggest">防水怎么做？</view>
        <view class="sug-chip" data-q="装修预算怎么分配比较合理？" bindtap="sendSuggest">预算怎么分配？</view>
        <view class="sug-chip" data-q="水电验收要注意什么？" bindtap="sendSuggest">水电验收要点</view>
      </view>
    </view>

    <view wx:for="{{messages}}" wx:key="index" id="msg{{index}}" class="msg-row {{item.role === 'user' ? 'me' : 'ai'}}">
      <view wx:if="{{item.role !== 'user'}}" class="avatar">🤖</view>
      <view class="msg-col">
        <view class="bubble {{item.role === 'user' ? 'bubble-me' : 'bubble-ai'}}">{{item.text}}</view>
        <view wx:if="{{item.sources.length}}" class="src-row">
          <text
            wx:for="{{item.sources}}"
            wx:for-item="s"
            wx:key="id"
            class="src-chip"
            bindtap="goSource"
            data-id="{{s.id}}">📄 {{s.title}}</text>
        </view>
      </view>
    </view>

    <!-- 等待回复：三个呼吸点 -->
    <view wx:if="{{loading}}" class="msg-row ai">
      <view class="avatar">🤖</view>
      <view class="msg-col">
        <view class="bubble bubble-ai typing">
          <text class="dot d1">●</text><text class="dot d2">●</text><text class="dot d3">●</text>
        </view>
      </view>
    </view>
    <view style="height:24rpx"></view>
  </scroll-view>

  <!-- 输入条：adjust-position 关闭 + kbHeight 抬升，避免被键盘遮挡 -->
  <view class="chat-input" style="margin-bottom:{{kbHeight}}px">
    <input
      class="chat-input-field"
      value="{{input}}"
      confirm-type="send"
      adjust-position="{{false}}"
      placeholder="问点装修的事…"
      bindinput="onInput"
      bindconfirm="send"
    />
    <view class="send-btn {{loading || !input ? 'send-disabled' : ''}}" bindtap="send">发送</view>
  </view>
</view>
