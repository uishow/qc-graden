<view class="page-root {{theme}}">
  <view class="card">
    <view class="field-label">ima 分享链接</view>
    <textarea class="textarea" placeholder="粘贴 ima 知识库/笔记的分享链接（微信转发来的卡片也能自动识别）"
      value="{{link}}" bindinput="onLinkInput" auto-height />
    <view class="hint">支持微信分享卡片格式（@share-html#… 包裹串会自动提取里面的真实链接）。MVP 阶段先保存链接卡片，正文抓取将在后续版本（接入 ima API）补齐。</view>
  </view>

  <view class="card">
    <view class="field-label">标题（可选，留空自动命名）</view>
    <input class="input" placeholder="例如：卫生间防水验收要点" value="{{title}}" bindinput="onTitleInput" />

    <view class="field-label">导入备注（可选）</view>
    <textarea class="textarea" placeholder="给家人看的一句话说明…" value="{{note}}" bindinput="onNoteInput" auto-height />

    <view class="field-label">归类到</view>
    <scroll-view scroll-x style="white-space:nowrap">
      <view wx:for="{{categories}}" wx:key="id"
        class="tag {{index === activeCategory ? 'tag-accent' : ''}}"
        style="padding:10rpx 28rpx;font-size:26rpx"
        data-index="{{index}}" bindtap="onCategoryTap">{{item.name}}</view>
    </scroll-view>
  </view>

  <view class="btn-primary" bindtap="doImport">{{saving ? '导入中…' : '导入到知识库'}}</view>
</view>
