<view class="page-root {{theme}}">
  <!-- 顶部标题行 + 记一篇（点开可选手写或 AI 生成本周进展；原右下角悬浮按钮会被自定义 tabBar 遮挡，改为普通按钮） -->
  <view class="section-head">
    <view class="section-title">装修日记</view>
    <view class="btn-add" bindtap="goAdd">＋ 记一篇</view>
  </view>

  <!-- 云端定时生成的本周进展卡片（方案A）：可存为日记留档，可收起 -->
  <view wx:if="{{digestText}}" class="card digest-card">
    <view class="between">
      <view style="font-weight:600">📊 本周装修进展{{digestAuto ? '（自动生成）' : ''}}</view>
      <view style="display:flex;gap:24rpx;align-items:center">
        <view class="digest-save" bindtap="saveDigestAsDiary">存为日记</view>
        <view class="muted" bindtap="closeDigest">收起</view>
      </view>
    </view>
    <view style="margin-top:12rpx;line-height:1.7;white-space:pre-wrap">{{digestText}}</view>
    <view class="digest-foot muted">{{digestTime ? digestTime + ' 生成 · ' : ''}}{{digestStats}}</view>
  </view>

  <view wx:if="{{empty}}" class="empty">
    <view>还没有日记</view>
    <view class="muted" style="margin-top:12rpx">点右上角「记一篇」，留下装修的第一天</view>
  </view>

  <block wx:for="{{groups}}" wx:key="date" wx:for-item="group">
    <view class="muted" style="margin:20rpx 0 12rpx;font-weight:600">{{group.date}}</view>
    <view wx:for="{{group.items}}" wx:key="id" class="card" bindtap="goDetail" data-id="{{item.id}}">
      <view class="title-serif" style="font-size:30rpx">{{item.title}}</view>
      <view class="muted" style="margin-top:6rpx" wx:if="{{item.summary}}">{{item.summary}}…</view>
      <view class="muted" style="margin-top:6rpx" wx:if="{{item.imageCount}}">📷 {{item.imageCount}} 张</view>
    </view>
  </block>
</view>
