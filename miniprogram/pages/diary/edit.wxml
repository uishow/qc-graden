<view class="page-root {{theme}}">
  <view class="field-label">标题 *</view>
  <input class="input" maxlength="{{-1}}" placeholder="今天工地发生了什么？" value="{{title}}" data-field="title" bindinput="onInput" />

  <view class="field-label">正文</view>
  <!-- maxlength 必须显式 -1：textarea 默认限 140 字，AI 草稿会被截断显示；auto-height 随内容长高 -->
  <textarea class="textarea" auto-height maxlength="{{-1}}" placeholder="记录进展、问题、心得…" value="{{content}}" data-field="content" bindinput="onInput" />

  <view class="field-label">日期</view>
  <picker mode="date" value="{{diaryDate}}" bindchange="onDateChange">
    <view class="input">{{diaryDate}}</view>
  </picker>

  <view class="row" style="gap:20rpx">
    <view style="flex:1">
      <view class="field-label">房间</view>
      <view class="input picker" bindtap="openRoomPicker">
        <block wx:if="{{roomIds.length === 0}}"><text class="picker-empty">选择房间（可多选）</text></block>
        <block wx:else><text class="picker-text" style="color:var(--c-primary)">{{roomIds.length}} 个房间 · {{roomText}}</text></block>
      </view>
    </view>
    <view style="flex:1">
      <view class="field-label">施工阶段</view>
      <view class="input picker" bindtap="openStagePicker">
        <block wx:if="{{stageIdsSelected.length === 0}}"><text class="picker-empty">选择阶段（可多选）</text></block>
        <block wx:else><text class="picker-text" style="color:var(--c-primary)">{{stageIdsSelected.length}} 个阶段 · {{stageText}}</text></block>
      </view>
    </view>
  </view>

  <view class="field-label">图片（{{localImages.length}}/9）</view>
  <view style="display:flex;flex-wrap:wrap;gap:12rpx">
    <view wx:for="{{localImages}}" wx:key="*this" style="position:relative">
      <image src="{{item}}" mode="aspectFill" style="width:160rpx;height:160rpx;border-radius:12rpx" />
      <view catchtap="removeImage" data-index="{{index}}" style="position:absolute;top:-10rpx;right:-10rpx;background:var(--c-primary);color:#fff;width:36rpx;height:36rpx;border-radius:50%;text-align:center;line-height:36rpx;font-size:24rpx">×</view>
    </view>
    <view wx:if="{{localImages.length < 9}}" bindtap="chooseImages" style="width:160rpx;height:160rpx;border-radius:12rpx;border:1rpx dashed var(--c-text-2);display:flex;align-items:center;justify-content:center;color:var(--c-text-2)">＋</view>
  </view>

  <view class="btn-primary" style="margin-top:40rpx" bindtap="onSave">{{saving ? '保存中…' : '保存'}}</view>

  <!-- 房间多选弹窗：嵌入 page-root 内部，让 fixed 定位稳定生效（部分机型顶级兄弟节点 fixed 失效） -->
  <view wx:if="{{showRoomPicker}}" class="mask" bindtap="cancelRoomPicker">
    <view class="sheet" catchtap="noop">
      <view class="between sheet-head">
        <view style="font-weight:600;font-size:32rpx">选择房间（可多选）</view>
        <view class="muted" bindtap="cancelRoomPicker">✕</view>
      </view>
      <view class="sheet-body">
        <view wx:if="{{rooms.length === 0}}" class="empty">暂无可选房间</view>
        <view
          wx:for="{{rooms}}"
          wx:key="id"
          class="multi-row {{index === rooms.length - 1 ? 'multi-row-last' : ''}} {{roomChecked[index] ? 'multi-row-checked' : ''}}"
          bindtap="toggleRoom"
          data-index="{{index}}"
        >
          <view class="multi-name">{{item.name}}</view>
          <view class="multi-check"></view>
        </view>
      </view>
      <view class="sheet-foot">
        <view class="row" style="gap:16rpx">
          <view class="btn-outline flex1" bindtap="cancelRoomPicker">取消</view>
          <view class="btn-primary flex1" bindtap="confirmRoomPicker">确定</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 阶段多选弹窗 -->
  <view wx:if="{{showStagePicker}}" class="mask" bindtap="cancelStagePicker">
    <view class="sheet" catchtap="noop">
      <view class="between sheet-head">
        <view style="font-weight:600;font-size:32rpx">选择施工阶段（可多选）</view>
        <view class="muted" bindtap="cancelStagePicker">✕</view>
      </view>
      <view class="sheet-body">
        <view wx:if="{{stages.length === 0}}" class="empty">暂无可选阶段</view>
        <view
          wx:for="{{stages}}"
          wx:key="id"
          class="multi-row {{index === stages.length - 1 ? 'multi-row-last' : ''}} {{stageChecked[index] ? 'multi-row-checked' : ''}}"
          bindtap="toggleStage"
          data-index="{{index}}"
        >
          <view class="multi-name">{{item.name}}</view>
          <view class="multi-check"></view>
        </view>
      </view>
      <view class="sheet-foot">
        <view class="row" style="gap:16rpx">
          <view class="btn-outline flex1" bindtap="cancelStagePicker">取消</view>
          <view class="btn-primary flex1" bindtap="confirmStagePicker">确定</view>
        </view>
      </view>
    </view>
  </view>
</view>
