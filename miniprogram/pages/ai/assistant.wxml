<view class="page-root {{theme}} chat-page">
  <scroll-view class="chat-body" scroll-y scroll-into-view="{{lastId}}" scroll-with-animation>
    <!-- 顶部：项目快照卡（默认展开，含建议问题） -->
    <view class="card snap-card">
      <view class="between">
        <view class="snap-title">📌 当前项目速览</view>
        <view class="muted snap-toggle" bindtap="toggleSnap">{{snapCollapsed ? '展开 ▾' : '收起 ▴'}}</view>
      </view>
      <view wx:if="{{snapReady}}">
        <!-- 展示字段在 snapshotView（snapshot 是发给云函数的、只有 name 没有统计文本），此前误读 snapshot.* 导致恒显示「尚未设置」 -->
        <view class="snap-line"><text class="snap-k">项目：</text>{{snapshotView.projectName || '—'}}</view>
        <view class="snap-line"><text class="snap-k">阶段：</text>{{snapshotView.stagesText || '尚未设置'}}</view>
        <view wx:if="{{!snapCollapsed}}">
          <view class="snap-line"><text class="snap-k">已花费：</text>{{snapshotView.spentText}} <text class="snap-k">本月：</text>{{snapshotView.monthText}}</view>
          <view class="snap-line"><text class="snap-k">材料：</text>{{snapshotView.materialsText}}</view>
          <view class="snap-line"><text class="snap-k">房间：</text>{{snapshotView.roomsText}} <text class="snap-k">日记：</text>{{snapshotView.diariesText}}</view>
        </view>
      </view>
      <view wx:else class="muted" style="margin-top:8rpx">正在加载项目数据…</view>

      <view wx:if="{{!snapCollapsed}}" class="snap-sug">
        <view class="snap-sug-title muted">试试问我：</view>
        <view class="snap-sug-wrap">
          <view class="snap-sug-chip" bindtap="sendSuggest" data-q="我现在装修到哪个阶段了？">📍 当前阶段</view>
          <view class="snap-sug-chip" bindtap="sendSuggest" data-q="我下一步该干啥了？">➡️ 下一步</view>
          <view class="snap-sug-chip" bindtap="sendSuggest" data-q="目前装修进度有哪些风险？">⚠️ 风险点</view>
          <view class="snap-sug-chip" bindtap="sendSuggest" data-q="看一看{{firstRoom || '主卧'}}做了哪些装修？">🛏️ 看主卧</view>
        </view>
      </view>
    </view>

    <!-- 空状态：欢迎 + 提示 -->
    <view wx:if="{{messages.length === 0 && snapReady}}" class="chat-empty">
      <view class="empty-avatar">🤖</view>
      <view class="empty-title">装修管家 AI</view>
      <view class="empty-sub muted">已读完你项目里的真实数据；提个具体问题，能答得更准。</view>
    </view>

    <view wx:for="{{messages}}" wx:key="index" id="msg{{index}}" class="msg-row {{item.role === 'user' ? 'me' : 'ai'}}">
      <view wx:if="{{item.role !== 'user' && item.type !== 'entry'}}" class="avatar">🤖</view>
      <view class="msg-col">
        <!-- 录入预览确认卡：经典布局——「修改」为标题右侧小链接，底部 取消|确认 两键。
             上一版三按钮挤一行/两行排布均不美观，且阶段卡漏渲染了确认按钮（2026-10-15 用户二轮反馈） -->
        <view wx:if="{{item.type === 'entry'}}" class="entry-card">
          <view class="between">
            <view class="entry-head">请确认{{item.entry.kind === 'stage' ? '修改' : '录入'}}信息</view>
            <view wx:if="{{item.entry.kind !== 'stage'}}" class="entry-edit-link" bindtap="openEntryForm">修改</view>
          </view>
          <view wx:for="{{item.entry.rows}}" wx:for-item="row" wx:key="index" class="entry-row">
            <text class="entry-k">{{row[0]}}</text>
            <text class="entry-v">{{row[1]}}</text>
          </view>
          <view class="entry-actions">
            <view class="entry-btn entry-cancel" bindtap="cancelEntry">取消</view>
            <view class="entry-btn entry-ok" bindtap="confirmEntry">{{item.entry.kind === 'stage' ? '确认修改' : '确认写入'}}</view>
          </view>
        </view>
        <!-- 普通文本/图片气泡 -->
        <view wx:else class="bubble {{item.role === 'user' ? 'bubble-me' : 'bubble-ai'}}">
          <text>{{item.text}}</text>
          <view wx:if="{{item.images && item.images.length}}" class="bubble-imgs">
            <image
              wx:for="{{item.images}}"
              wx:for-item="img"
              wx:for-index="imgIdx"
              wx:key="imgIdx"
              class="bubble-img"
              src="{{img}}"
              mode="aspectFill"
              data-imgs="{{item.images}}"
              data-cur="{{img}}"
              bindtap="previewMsgImage"
            />
          </view>
        </view>
      </view>
    </view>

    <!-- 等待回复：三呼吸点 -->
    <view wx:if="{{loading}}" class="msg-row ai">
      <view class="avatar">🤖</view>
      <view class="msg-col">
        <view class="bubble bubble-ai typing">
          <text class="dot d1">●</text><text class="dot d2">●</text><text class="dot d3">●</text>
        </view>
      </view>
    </view>
    <view style="height:24rpx"></view>
  </scroll-view>

  <!-- 输入条（键盘弹起抬升：margin-bottom = kbHeight）。多行 textarea 自动增高，便于录入长文本 -->
  <view class="chat-input" style="margin-bottom:{{kbHeight}}px">
    <textarea
      class="chat-input-field"
      value="{{input}}"
      auto-height
      maxlength="500"
      adjust-position="{{false}}"
      placeholder="问装修管家，或录入材料 / 花费 / 日记（多行可见，便于看全信息）"
      bindinput="onInput"
    />
    <view class="send-btn {{loading || !input ? 'send-disabled' : ''}}" bindtap="send">发送</view>
  </view>

  <!-- Phase 3：引导式半屏编辑表单（从预览卡点「修改」进入，预填解析结果，可改后落库） -->
  <view wx:if="{{formOpen}}" class="mask" bindtap="closeEntryForm" catchtouchmove="noop">
    <view class="sheet" style="margin-bottom:{{kbHeight}}px" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">{{formKind === 'material' ? '修改材料' : (formKind === 'expense' ? '修改花费' : '修改日记')}}</text>
        <text class="sheet-close" bindtap="closeEntryForm">✕</text>
      </view>

      <view class="sheet-body">
        <!-- 材料 -->
        <block wx:if="{{formKind === 'material'}}">
          <view class="form-block">
            <view class="form-label">材料名称 <text class="req">*</text></view>
            <input class="form-input" value="{{form.name}}" placeholder="如：木门" data-field="name" bindinput="onFormInput" adjust-position="{{false}}" />
          </view>
          <view class="form-block">
            <view class="form-label">品牌</view>
            <input class="form-input" value="{{form.brand}}" placeholder="如：欧派（可留空）" data-field="brand" bindinput="onFormInput" adjust-position="{{false}}" />
          </view>
          <view class="form-row">
            <view class="form-block form-flex">
              <view class="form-label">数量</view>
              <input class="form-input" type="digit" value="{{form.quantity}}" placeholder="1" data-field="quantity" bindinput="onFormInput" adjust-position="{{false}}" />
            </view>
            <view class="form-block form-flex">
              <view class="form-label">单位</view>
              <input class="form-input" value="{{form.unit}}" placeholder="张/个/桶/平方" data-field="unit" bindinput="onFormInput" adjust-position="{{false}}" />
            </view>
          </view>
          <view class="form-block">
            <view class="form-label">单价（元）</view>
            <input class="form-input" type="digit" value="{{form.unitPriceYuan}}" placeholder="如：300" data-field="unitPriceYuan" bindinput="onFormInput" adjust-position="{{false}}" />
          </view>
          <view class="form-block">
            <view class="form-label">备注 / 要求</view>
            <textarea class="form-input form-textarea" value="{{form.note}}" placeholder="如：本周日上门安装" maxlength="{{500}}" data-field="note" bindinput="onFormInput" adjust-position="{{false}}" />
          </view>
        </block>

        <!-- 花费 -->
        <block wx:if="{{formKind === 'expense'}}">
          <view class="form-block">
            <view class="form-label">金额（元）<text class="req">*</text></view>
            <input class="form-input" type="digit" value="{{form.amountYuan}}" placeholder="如：5000" data-field="amountYuan" bindinput="onFormInput" adjust-position="{{false}}" />
          </view>
          <view class="form-block">
            <view class="form-label">类别</view>
            <view class="form-chips">
              <view
                wx:for="{{typeOptions}}"
                wx:key="index"
                class="form-chip {{form.typeIndex === index ? 'on' : ''}}"
                data-idx="{{index}}"
                bindtap="onFormTypePick"
              >{{item}}</view>
            </view>
          </view>
          <view class="form-block">
            <view class="form-label">支付日期</view>
            <input class="form-input" value="{{form.payDate}}" placeholder="YYYY-MM-DD" data-field="payDate" bindinput="onFormInput" adjust-position="{{false}}" />
          </view>
          <view wx:if="{{raw.stages.length}}" class="form-block">
            <view class="form-label">关联阶段（可多选）</view>
            <view class="form-chips">
              <view
                wx:for="{{raw.stages}}"
                wx:key="id"
                class="form-chip {{form.stageSet.indexOf(item.id) >= 0 ? 'on' : ''}}"
                data-id="{{item.id}}"
                bindtap="toggleFormStage"
              >{{item.name}}</view>
            </view>
          </view>
          <view class="form-block">
            <view class="form-label">备注 / 事由</view>
            <input class="form-input" value="{{form.remark}}" placeholder="如：泥工师傅工钱" data-field="remark" bindinput="onFormInput" adjust-position="{{false}}" />
          </view>
        </block>

        <!-- 日记 -->
        <block wx:if="{{formKind === 'diary'}}">
          <view class="form-block">
            <view class="form-label">标题</view>
            <input class="form-input" value="{{form.title}}" placeholder="如：水电验收（≤20字）" data-field="title" bindinput="onFormInput" adjust-position="{{false}}" />
          </view>
          <view class="form-block">
            <view class="form-label">正文<text class="req">*</text></view>
            <textarea class="form-input form-textarea" value="{{form.content}}" placeholder="今天现场发生了什么…" maxlength="{{1000}}" data-field="content" bindinput="onFormInput" adjust-position="{{false}}" />
          </view>
          <view class="form-block">
            <view class="form-label">日期</view>
            <input class="form-input" value="{{form.diaryDate}}" placeholder="YYYY-MM-DD" data-field="diaryDate" bindinput="onFormInput" adjust-position="{{false}}" />
          </view>
          <view wx:if="{{raw.rooms.length}}" class="form-block">
            <view class="form-label">关联房间（可多选）</view>
            <view class="form-chips">
              <view
                wx:for="{{raw.rooms}}"
                wx:key="id"
                class="form-chip {{form.roomSet.indexOf(item.id) >= 0 ? 'on' : ''}}"
                data-id="{{item.id}}"
                bindtap="toggleFormRoom"
              >{{item.name}}</view>
            </view>
          </view>
          <view wx:if="{{raw.stages.length}}" class="form-block">
            <view class="form-label">关联阶段（可多选）</view>
            <view class="form-chips">
              <view
                wx:for="{{raw.stages}}"
                wx:key="id"
                class="form-chip {{form.stageSet.indexOf(item.id) >= 0 ? 'on' : ''}}"
                data-id="{{item.id}}"
                bindtap="toggleFormStage"
              >{{item.name}}</view>
            </view>
          </view>
        </block>
      </view>

      <view class="sheet-foot">
        <view class="entry-btn entry-cancel" bindtap="closeEntryForm">取消</view>
        <view class="entry-btn entry-ok" bindtap="confirmFromForm">确认写入</view>
      </view>
    </view>
  </view>
</view>
