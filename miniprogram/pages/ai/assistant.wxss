/* 沿用 knowledge/chat 的消息流样式；快照卡专属样式另起 */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}
.chat-body {
  flex: 1;
  min-height: 0;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

/* 快照卡 */
.snap-card { padding: 20rpx 24rpx; }
.snap-title { font-weight: 600; font-size: 28rpx; }
.snap-toggle { font-size: 24rpx; }
.snap-line { font-size: 26rpx; line-height: 1.7; color: var(--c-text); }
.snap-k { color: var(--c-text-2); margin-right: 4rpx; }
.snap-sug { margin-top: 16rpx; border-top: 1rpx solid var(--c-card-border); padding-top: 16rpx; }
.snap-sug-title { font-size: 22rpx; margin-bottom: 8rpx; }
.snap-sug-wrap { display: flex; flex-wrap: wrap; gap: 12rpx; }
.snap-sug-chip {
  font-size: 24rpx;
  color: var(--c-primary);
  background: var(--c-secondary-bg);
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
}
.snap-sug-chip:active { opacity: 0.8; }

/* 空状态 */
.chat-empty {
  display: flex; flex-direction: column; align-items: center;
  margin-top: 12vh; text-align: center;
}
.empty-avatar {
  width: 128rpx; height: 128rpx; border-radius: 50%;
  background: var(--c-secondary-bg);
  display: flex; align-items: center; justify-content: center;
  font-size: 64rpx;
}
.empty-title { margin-top: 24rpx; font-size: 32rpx; font-weight: 600; color: var(--c-text); }
.empty-sub { margin-top: 10rpx; font-size: 26rpx; padding: 0 40rpx; }

/* 消息行 */
.msg-row { display: flex; align-items: flex-start; margin: 24rpx 0; }
.msg-row.me { justify-content: flex-end; }
.avatar {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: var(--c-secondary-bg);
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; flex-shrink: 0; margin-right: 14rpx;
}
.msg-col { max-width: 82%; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; }
.msg-row.me .msg-col { align-items: flex-end; }
.bubble {
  max-width: 100%;
  padding: 18rpx 24rpx;
  font-size: 28rpx; line-height: 1.6;
  word-break: break-all; white-space: pre-wrap;
}
.bubble-ai {
  background: var(--c-card); color: var(--c-text);
  border: 1rpx solid var(--c-card-border);
  border-radius: 4rpx 18rpx 18rpx 18rpx;
}
.bubble-me {
  background: var(--c-primary); color: #ffffff;
  border-radius: 18rpx 18rpx 4rpx 18rpx;
}

/* 录入预览确认卡 */
.entry-card {
  width: 100%;
  max-width: 560rpx;
  background: var(--c-card);
  border: 1rpx solid var(--c-card-border);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}
.entry-head {
  font-size: 26rpx; font-weight: 500;
  color: var(--c-text);
  margin-bottom: 12rpx;
}
.entry-row {
  display: flex; align-items: baseline;
  font-size: 26rpx; line-height: 1.7;
}
.entry-k {
  flex-shrink: 0; width: 96rpx;
  color: var(--c-text-2);
  margin-right: 16rpx;
}
.entry-v {
  flex: 1; color: var(--c-text);
  word-break: break-all;
}
.entry-actions {
  display: flex; gap: 16rpx;
  margin-top: 18rpx;
}
.entry-btn {
  flex: 1; text-align: center;
  font-size: 26rpx; font-weight: 500;
  padding: 16rpx 0;
  border-radius: 10rpx;
}
.entry-cancel {
  background: var(--c-secondary-bg);
  color: var(--c-text-2);
}
.entry-ok {
  background: var(--c-primary);
  color: #ffffff;
}
.entry-ok:active { opacity: 0.85; }
.entry-cancel:active { opacity: 0.85; }
/* 「修改」入口：标题右侧小链接（次操作不占底部按钮位，底部只留 取消|确认 两键） */
.entry-edit-link {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--c-primary);
  border: 1rpx solid var(--c-primary);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin-left: 12rpx;
}
.entry-edit-link:active { opacity: 0.8; }

/* —— Phase 3：引导式半屏编辑表单 ——
   .mask 显式四向归零钉底 + flex column end；.sheet flex column，
   .sheet-body flex:1 + min-height:0 + overflow-y:auto（缺 min-height:0 会把 foot 顶出裁切） */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 99999; /* 需高于自定义 tabBar 的框架包装层 */
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.sheet {
  width: 100%;
  max-height: 78vh;
  background: var(--c-card);
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 0 0 calc(16rpx + env(safe-area-inset-bottom));
}
.sheet-head {
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 28rpx 16rpx;
  border-bottom: 1rpx solid var(--c-card-border);
}
.sheet-title { font-size: 30rpx; font-weight: 600; color: var(--c-text); }
.sheet-close { font-size: 30rpx; color: var(--c-text-2); padding: 0 6rpx; }
.sheet-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 8rpx 28rpx 16rpx;
  box-sizing: border-box;
}
.sheet-foot {
  flex-shrink: 0;
  display: flex; gap: 16rpx;
  padding: 16rpx 28rpx 0;
  border-top: 1rpx solid var(--c-card-border);
}

/* 表单控件 */
.form-block { margin-top: 20rpx; }
.form-row { display: flex; gap: 16rpx; }
.form-flex { flex: 1; min-width: 0; }
.form-label { font-size: 25rpx; color: var(--c-text-2); margin-bottom: 10rpx; }
.req { color: #e5484d; }
/* input 必须显式 height + line-height：只给 padding 时部分基础库把内容区压扁，预填文字被上下裁半（2026-10-15 用户实测） */
.form-input {
  background: var(--c-secondary-bg);
  border: 1rpx solid var(--c-card-border);
  border-radius: 12rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--c-text);
  width: 100%;
  box-sizing: border-box;
}
/* textarea 覆盖：不能用固定 height/line-height，auto 高度 + 上下 padding */
.form-textarea {
  height: auto;
  min-height: 160rpx;
  line-height: 1.6;
  padding: 16rpx 20rpx;
}
.form-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.form-chip {
  font-size: 25rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: var(--c-secondary-bg);
  color: var(--c-text-2);
  border: 1rpx solid var(--c-card-border);
}
.form-chip.on {
  background: var(--c-primary);
  color: #ffffff;
  border-color: var(--c-primary);
}
.form-chip:active { opacity: 0.8; }

.typing { white-space: normal; display: flex; align-items: center; padding: 20rpx 24rpx; }
.dot { font-size: 24rpx; margin: 0 5rpx; color: var(--c-text-2); animation: dot-blink 1.2s infinite; }
.d2 { animation-delay: 0.2s; }
.d3 { animation-delay: 0.4s; }
@keyframes dot-blink {
  0%, 80%, 100% { opacity: 0.2; }
  40% { opacity: 1; }
}

/* 气泡内附件图片（日记附件查询结果） */
.bubble-imgs {
  display: flex; flex-wrap: wrap; gap: 10rpx;
  margin-top: 12rpx;
}
.bubble-img {
  width: 200rpx; height: 200rpx;
  border-radius: 12rpx;
  background: var(--c-secondary-bg);
}
.bubble-img:active { opacity: 0.85; }

/* 气泡内的可点引导 chips（避免用户照文字重打导致说法对不上） */
.bubble-sugs {
  display: flex; flex-wrap: wrap; gap: 12rpx;
  margin-top: 14rpx;
}
.bubble-sug {
  font-size: 24rpx;
  color: var(--c-primary);
  background: var(--c-secondary-bg);
  border: 1rpx solid var(--c-primary);
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
  max-width: 100%;
}
.bubble-sug:active { opacity: 0.8; }

/* 输入条 */
.chat-input {
  flex-shrink: 0;
  display: flex; gap: 16rpx; align-items: flex-end;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--c-bg);
  border-top: 1rpx solid var(--c-secondary-bg);
}
.chat-input-field {
  flex: 1; min-width: 0;
  background: var(--c-secondary-bg);
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx; line-height: 1.5;
  color: var(--c-text);
  /* 默认 3 行高：录入长文本（自然语录入）一屏看得全，超出继续长高到 6 行封顶再内滚 */
  min-height: 132rpx;
  max-height: 300rpx;
}
.send-btn {
  flex-shrink: 0;
  background: var(--c-primary); color: #ffffff;
  border-radius: 999rpx;
  font-size: 28rpx; font-weight: 600;
  padding: 14rpx 34rpx;
}
.send-btn:active { opacity: 0.85; }
.send-disabled { opacity: 0.4; }
