.fb-head {
  margin-bottom: 20rpx;
}
.fb-filters {
  display: flex; flex-wrap: wrap; gap: 12rpx;
  margin-bottom: 20rpx;
}
.fb-filter {
  font-size: 24rpx;
  color: var(--c-text-2);
  background: var(--c-card);
  border: 1rpx solid var(--c-card-border);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}
.fb-filter.on {
  color: #FFFFFF;
  background: var(--c-primary);
  border-color: var(--c-primary);
}
.fb-card { margin-bottom: 16rpx; }
.fb-title { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.fb-signal { font-weight: 600; font-size: 28rpx; }
.fb-intent {
  font-size: 22rpx; color: var(--c-primary);
  background: var(--c-accent-bg);
  border-radius: 6rpx; padding: 2rpx 10rpx;
}
.fb-count {
  font-size: 26rpx; font-weight: 600; color: var(--c-danger);
  flex-shrink: 0;
}
.fb-sample {
  margin-top: 14rpx;
  background: var(--c-secondary-bg);
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
}
.fb-line { font-size: 24rpx; line-height: 1.7; word-break: break-all; }
.fb-k { color: var(--c-text-2); }
.fb-fixed { color: var(--c-success); }
.fb-more { font-size: 22rpx; margin-top: 10rpx; }
.fb-actions {
  display: flex; gap: 12rpx; margin-top: 16rpx; flex-wrap: wrap;
}
.fb-btn {
  font-size: 24rpx;
  color: var(--c-text);
  background: var(--c-card);
  border: 1rpx solid var(--c-card-border);
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
}
.fb-btn-ok { color: #FFFFFF; background: var(--c-success); border-color: var(--c-success); }
.fb-btn:active { opacity: 0.8; }
.fb-empty { text-align: center; padding: 80rpx 0; }
