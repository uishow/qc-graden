/* 主题令牌来自 app.wxss */

/* 我的页项目卡片：左信息 + 右操作（当前/管理） */
.proj { display: flex; align-items: center; justify-content: space-between; }
.proj-main { min-width: 0; flex: 1; }
.proj-side { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; margin-left: 16rpx; }

/* 成员管理面板 */
.block { margin-top: 24rpx; }
.block-title { font-size: 24rpx; color: var(--c-text-2); margin-bottom: 12rpx; }
.code-row { display: flex; align-items: center; gap: 12rpx; }
.code-val {
  flex: 1;
  background: var(--c-card);
  border: 1rpx solid var(--c-card-border);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 40rpx;
  letter-spacing: 10rpx;
  font-weight: 600;
  text-align: center;
}
.member-row { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 0; border-top: 1rpx solid var(--c-card-border); }
.member-main { min-width: 0; flex: 1; }

