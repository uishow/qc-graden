<view class="page-root {{theme}}">
  <view wx:if="{{empty}}" class="empty">请先创建项目</view>

  <block wx:else>
    <!-- Tab 切换：费用总览 / 材料清单 / 花费清单 / 全屋定制（参考知识库分块方式） -->
    <view class="tabs">
      <view class="tab {{activeTab === 0 ? 'tab-on' : ''}}" data-tab="0" bindtap="switchTab">费用总览</view>
      <view class="tab {{activeTab === 1 ? 'tab-on' : ''}}" data-tab="1" bindtap="switchTab">材料清单</view>
      <view class="tab {{activeTab === 2 ? 'tab-on' : ''}}" data-tab="2" bindtap="switchTab">花费清单</view>
      <view class="tab {{activeTab === 3 ? 'tab-on' : ''}}" data-tab="3" bindtap="switchTab">全屋定制</view>
    </view>

    <!-- Tab 0：费用总览（预算进度 KPI + 按阶段 / 按花费类目 / 按材料类型） -->
    <block wx:if="{{activeTab === 0}}">
      <view class="card">
        <view class="between">
          <view>
            <view class="muted">已花费</view>
            <view class="accent" style="font-size:44rpx">{{spentText}}</view>
          </view>
          <view style="text-align:right">
            <view class="muted">预算 {{budgetText}}</view>
            <view class="muted">剩余 {{remainText}}</view>
          </view>
        </view>
        <view style="height:12rpx;background:var(--c-secondary-bg);border-radius:999rpx;margin-top:20rpx">
          <view style="height:12rpx;width:{{spentPercent}}%;background:var(--c-accent);border-radius:999rpx"></view>
        </view>
      </view>

      <view class="section-head">
        <view class="section-title">按阶段</view>
      </view>
      <view class="card">
        <view wx:if="{{stageRollups.length === 0}}" class="muted">还没有按阶段归类的花费/材料（记一笔或加材料时可选「所属阶段」）</view>
        <view wx:for="{{stageRollups}}" wx:key="name" class="between" style="padding:8rpx 0">
          <view>{{item.name}}</view>
          <view class="muted">花费 {{item.expText}} · 材料 {{item.matText}}</view>
        </view>
      </view>

      <view class="section-head">
        <view class="section-title">按花费类目</view>
      </view>
      <view class="card">
        <view wx:if="{{typeSums.length === 0}}" class="muted">还没有非材料类花费（材料支出在「材料清单」登记，自动计入预算）</view>
        <view wx:for="{{typeSums}}" wx:key="name" class="between" style="padding:8rpx 0">
          <view>{{item.name}}</view>
          <view class="accent">{{item.text}}</view>
        </view>
      </view>

      <view class="section-head">
        <view class="section-title">按材料类型</view>
      </view>
      <view class="card">
        <view wx:if="{{matTypeTotals.length === 0}}" class="muted">暂无材料</view>
        <view wx:for="{{matTypeTotals}}" wx:key="name" class="between" style="padding:8rpx 0">
          <view>{{item.name}}</view>
          <view class="accent">{{item.text}}</view>
        </view>
      </view>
    </block>

    <!-- Tab 1：材料清单 -->
    <block wx:if="{{activeTab === 1}}">
      <view class="section-head">
        <view class="section-title">材料清单</view>
        <view style="display:flex;gap:12rpx;align-items:center">
          <view class="btn-outline sm" bindtap="goExportMaterials">导出 CSV</view>
          <view class="btn-add" bindtap="goAddMaterial">＋ 加材料</view>
        </view>
      </view>

      <view class="card between">
        <view>
          <view style="font-weight:600">材料合计</view>
          <view class="muted" style="font-size:22rpx;margin-top:4rpx">已购 {{matPurchasedText}}（计入已花费） · 待购 {{matPendingText}}</view>
        </view>
        <view class="accent" style="font-size:36rpx">{{matTotalText}}</view>
      </view>

      <view wx:if="{{matEmpty}}" class="card muted">清单是空的，点右上角「＋ 加材料」把要买的瓷砖、地板、洁具一件件加进来</view>

      <block wx:for="{{matGroups}}" wx:key="key" wx:for-item="group">
        <view class="muted" style="margin:20rpx 0 12rpx;font-weight:600">{{group.name}}（{{group.items.length}}）</view>
        <view wx:for="{{group.items}}" wx:key="id" class="card slim" bindtap="goEditMaterial" data-id="{{item.id}}">
          <view class="between">
            <view style="font-weight:600;flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-right:12rpx">{{item.name}}</view>
            <view class="accent" style="flex-shrink:0">{{item.totalText}}</view>
          </view>
          <view class="row" style="gap:12rpx;margin-top:8rpx">
            <view class="muted" style="flex:1;min-width:0;font-size:24rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{item.category}} · {{item.brand || '未填品牌'}} · x{{item.quantity}}{{item.unit || ''}}<block wx:if="{{item.attCount}}"> · 附件{{item.attCount}}</block></view>
            <view class="slim-del" catchtap="removeMaterial" data-id="{{item.id}}">删除</view>
            <view wx:if="{{item.status !== 'on_site'}}" class="slim-del" catchtap="advanceMaterialStatus"
              data-id="{{item.id}}" data-status="{{item.status}}">推进 →</view>
          </view>
        </view>
      </block>
    </block>

    <!-- Tab 2：花费清单（记一笔 + 明细） -->
    <block wx:if="{{activeTab === 2}}">
      <view class="section-head">
        <view class="section-title">花费清单</view>
        <view style="display:flex;gap:12rpx;align-items:center">
          <view class="btn-outline sm" bindtap="goExport">导出 CSV</view>
          <view class="btn-add" bindtap="goEdit">＋ 记一笔</view>
        </view>
      </view>

      <view style="font-weight:600;margin:24rpx 0 12rpx">明细</view>
      <view wx:if="{{recent.length === 0}}" class="card muted">还没有花费记录，点右上角「＋ 记一笔」</view>
      <view wx:for="{{recent}}" wx:key="id" class="card slim slim-row" bindtap="goEditItem" data-id="{{item.id}}">
        <view class="slim-main">
          <text class="slim-title">{{item.remark || item.typeName}}</text>
          <text class="slim-meta">{{item.pay_date}} · {{item.typeName}}<block wx:if="{{item.attCount}}"> · 附件{{item.attCount}}</block></text>
        </view>
        <view class="slim-right">
          <text class="slim-amount">{{item.amountText}}</text>
          <view catchtap="removeItem" data-id="{{item.id}}" class="slim-del">删除</view>
        </view>
      </view>
    </block>

    <!-- Tab 3：全屋定制（阶段进度卡 + 归集） -->
    <block wx:if="{{activeTab === 3}}">
      <view class="section-head">
        <view class="section-title">全屋定制</view>
        <view style="display:flex;gap:12rpx;align-items:center">
          <view class="btn-outline sm" bindtap="goExportWholeHouse">导出 CSV</view>
          <view class="btn-add" bindtap="goWholeHouse">{{wholeHouse.has ? '看阶段' : '去建阶段'}}</view>
        </view>
      </view>

      <view wx:if="{{wholeHouse.has}}" class="card" bindtap="goWholeHouse" style="border-left:8rpx solid var(--c-accent)">
        <view class="between">
          <view>
            <view style="font-weight:600">全屋定制<text wx:if="{{wholeHouse.count > 1}}">（共{{wholeHouse.count}}个阶段）</text></view>
            <view class="muted">阶段进度 · 点击进入阶段看板</view>
          </view>
          <view class="accent" style="font-weight:600">{{wholeHouse.statusName}}</view>
        </view>
        <view wx:if="{{whStages.length > 1}}" style="margin-top:12rpx">
          <view wx:for="{{whStages}}" wx:key="id" class="between slim-row" style="padding:10rpx 0;border-top:1rpx solid var(--c-secondary-bg)">
            <view class="slim-title">{{item.name}}</view>
            <view class="muted">{{item.statusName}}</view>
          </view>
        </view>
      </view>
      <view wx:else class="card muted">本项目暂无全屋定制环节，点右上角「去建阶段」在阶段看板创建</view>

      <!-- 全屋定制归集：只显示归属=全屋定制的材料/花费 -->
      <view class="card">
        <view class="between">
          <view class="muted">全屋定制合计</view>
          <view class="accent" style="font-size:36rpx">{{whTotalText}}</view>
        </view>
        <view class="between" style="margin-top:8rpx">
          <view class="muted">材料 {{whMatTotalText}}</view>
          <view class="muted">花费 {{whExpTotalText}}</view>
        </view>
        <view class="row" style="gap:16rpx;margin-top:16rpx">
          <view class="btn-outline sm" style="flex:1" bindtap="goAddWhMaterial">＋ 加材料</view>
          <view class="btn-outline sm" style="flex:1" bindtap="goAddWhExpense">＋ 记一笔</view>
        </view>
        <view wx:if="{{whSuggestCount > 0}}" class="btn-outline sm" style="margin-top:16rpx" bindtap="autoTagWholeHouse">一键归集疑似项（{{whSuggestCount}}）</view>
      </view>

      <view wx:if="{{whItems.length === 0}}" class="card muted">还没有归入全屋定制的材料/花费：点上面「＋」添加，或给已有条目把「归属」选为全屋定制</view>
      <view wx:for="{{whItems}}" wx:key="k" class="card slim slim-row" bindtap="goEditWhItem" data-kind="{{item.kind}}" data-id="{{item.id}}">
        <view class="slim-main">
          <text class="slim-title">{{item.title}}</text>
          <text class="slim-meta">{{item.kindName}} · {{item.sub}}<block wx:if="{{item.attCount}}"> · 附件{{item.attCount}}</block></text>
        </view>
        <text class="slim-amount">{{item.text}}</text>
      </view>
    </block>
  </block>

  <!-- 一键归集疑似项：勾选弹窗（flex column + 可滚主体，防底部按钮被裁切；打开期间隐藏 tabBar） -->
  <view wx:if="{{whSheet}}" class="mask" bindtap="cancelWhPick">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <view style="font-weight:600;font-size:32rpx">一键归集疑似项</view>
        <view class="muted" style="margin-top:8rpx">勾选要标记为「全屋定制」的条目（默认全选）</view>
      </view>
      <view class="sheet-body" style="margin-top:12rpx">
        <checkbox-group bindchange="onWhPickChange">
          <label wx:for="{{whPicks}}" wx:key="k" class="wh-pick-row">
            <checkbox value="{{item.k}}" checked="{{item.checked}}" />
            <view class="wh-pick-main">
              <text class="slim-title">{{item.title}}</text>
              <text class="slim-meta">{{item.kindName}}<block wx:if="{{item.sub}}"> · {{item.sub}}</block></text>
            </view>
          </label>
        </checkbox-group>
      </view>
      <view class="sheet-foot row" style="gap:16rpx;margin-top:20rpx">
        <view class="btn-outline flex1" bindtap="cancelWhPick">取消</view>
        <view class="btn-primary flex1" bindtap="confirmWhPick">归集已选（{{whPickedCount}}）</view>
      </view>
    </view>
  </view>
</view>
