.bar {
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  padding: 12rpx 8rpx calc(12rpx + env(safe-area-inset-bottom));
}
/* 主题色跟页面同步（组件内拿不到 page-root 的变量，这里按主题各定义一份） */
.bar.theme-a { --tab-accent: #b08a47; --tab-muted: #8a7e72; }
.bar.theme-b { --tab-accent: #c2a878; --tab-muted: #8a7e72; }

.item { flex: 1; display: flex; justify-content: center; }
.pill {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--tab-muted);
  transition: background 0.2s, color 0.2s;
}
.item.on .pill {
  background: var(--tab-accent);
  color: #ffffff;
  font-weight: 600;
}
